<Window x:Class="VeyroSetup.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка Veyro" Icon="app.ico" Width="780" Height="590" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterScreen" Foreground="#F4F2F2" FontFamily="Segoe UI">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#F4F2F2"/><Setter Property="Background" Value="#28262B"/><Setter Property="Padding" Value="18,12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Plate" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Opacity" Value="0.8"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Plate" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="#F4F2F2"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <DockPanel>
     <Border x:Name="Switch" DockPanel.Dock="Right" Width="42" Height="24" CornerRadius="12" Background="#46424A" Margin="16,0,0,0" Padding="3">
      <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left"/>
     </Border>
     <ContentPresenter VerticalAlignment="Center"/>
    </DockPanel>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Switch" Property="Background" Value="#DA4F59"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border Background="#18171B" BorderBrush="#3B353C" BorderThickness="1" CornerRadius="24">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border CornerRadius="24,0,0,24" Padding="30">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3C202A"/><GradientStop Color="#201C25" Offset="0.65"/><GradientStop Color="#19181D" Offset="1"/></LinearGradientBrush></Border.Background>
    <Grid>
     <StackPanel VerticalAlignment="Top" Margin="0,28,0,0">
      <Image Source="app.ico" Width="120" Height="120" HorizontalAlignment="Left"/>
      <TextBlock Text="Veyro" FontSize="42" FontWeight="SemiBold" Margin="0,24,0,12"/>
      <TextBlock Text="Ваш звук.&#x0a;Ваши правила." FontSize="23" Foreground="#D6BBC4" LineHeight="32"/>
     </StackPanel>
     <StackPanel VerticalAlignment="Bottom">
      <TextBlock Text="Громкость приложений&#x0a;Папки и умная сортировка&#x0a;Темы под ваш стиль" FontSize="13" Foreground="#B7A3AE" LineHeight="25"/>
      <TextBlock Text="Windows 10 / 11 · x64" FontSize="12" Foreground="#8F818D" Margin="0,20,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Column="1" Margin="32,24,32,28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Background="Transparent" MouseLeftButtonDown="DragHeader">
     <TextBlock x:Name="ModeLabel" Text="Установка" FontSize="13" Foreground="#ACA4B1" VerticalAlignment="Center"/>
     <Button x:Name="CloseButton" Content="×" HorizontalAlignment="Right" Padding="12,4" FontSize="22" Click="CloseSetup"/>
    </Grid>
    <StackPanel Grid.Row="1" Margin="0,30,0,0">
     <TextBlock x:Name="Heading" Text="Всё готово к установке" FontSize="27" FontWeight="SemiBold"/>
     <TextBlock x:Name="Description" Text="Настройте Veyro под себя перед первым запуском." FontSize="13" Foreground="#ACA4B1" TextWrapping="Wrap" Margin="0,10,0,26"/>
     <StackPanel x:Name="Options">
      <TextBlock Text="Папка установки" FontSize="13" Foreground="#ACA4B1" Margin="0,0,0,9"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Background="#232127" CornerRadius="12" Padding="12"><TextBox x:Name="InstallPath" Background="Transparent" BorderThickness="0" Foreground="#EEE9F0" CaretBrush="White" FontSize="12" VerticalContentAlignment="Center"/></Border>
       <Button Grid.Column="1" Content="Изменить" Click="BrowseFolder" Margin="8,0,0,0" Padding="12,10"/>
      </Grid>
      <Border Background="#232127" CornerRadius="14" Padding="18" Margin="0,22,0,0">
       <StackPanel>
        <CheckBox x:Name="Autostart" IsChecked="True" Content="Запускать вместе с Windows"/>
        <TextBlock Text="Veyro будет ждать в области уведомлений" FontSize="12" Foreground="#A79EAC" Margin="0,9,0,0"/>
       </StackPanel>
      </Border>
      <CheckBox x:Name="DesktopShortcut" Content="Ярлык на рабочем столе" IsChecked="False" Margin="18,18,18,0"/>
     </StackPanel>
     <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,30,0,0">
      <ProgressBar x:Name="Progress" Height="6" Background="#312932" Foreground="#DA4F59" BorderThickness="0" IsIndeterminate="True"/>
      <TextBlock x:Name="ProgressText" FontSize="13" Foreground="#B9AFBF" TextWrapping="Wrap" Margin="0,14,0,0"/>
     </StackPanel>
     <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#F49EA4" FontSize="12" Margin="0,16,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="2">
     <Button x:Name="InstallButton" Content="Установить Veyro  →" Background="#B63F4D" FontSize="16" FontWeight="SemiBold" Height="49" Click="Install"/>
     <TextBlock x:Name="Footer" Text="Для текущего пользователя · Интернет не требуется" FontSize="11" Foreground="#8F8696" HorizontalAlignment="Center" Margin="0,12,0,0"/>
    </StackPanel>
   </Grid>
  </Grid>
 </Border>
</Window>

